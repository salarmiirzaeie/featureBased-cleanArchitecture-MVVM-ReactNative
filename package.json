{
  "name": "starter-kit-expo",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "build": "expo export --platform web --output-dir dist",
    "build:preview": "expo export --platform web --output-dir dist",
    "test": "jest",
    "typecheck": "tsc --noEmit"
  },
  "jest": {
    "preset": "jest-expo",
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/$1"
    },
    "testMatch": [
      "<rootDir>/features/**/__tests__/**/*.test.ts?(x)"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?)|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@sentry/react-native|native-base|react-native-svg|@reduxjs/toolkit|immer|reselect|redux-thunk|react-redux|redux|use-sync-external-store)"
    ]
  },
  "dependencies": {
    "@expo/html-elements": "^0.12.5",
    "@expo/vector-icons": "^15.0.2",
    "@gluestack-ui/core": "^3.0.12",
    "@gluestack-ui/utils": "^3.0.13",
    "@gorhom/bottom-sheet": "^5.0.0-alpha.11",
    "@legendapp/motion": "^2.4.0",
    "@react-aria/utils": "^3.29.0",
    "@react-native-async-storage/async-storage": "^3.0.1",
    "@react-navigation/native": "^7.1.6",
    "@reduxjs/toolkit": "^2.11.2",
    "babel-plugin-module-resolver": "^5.0.2",
    "dom-helpers": "^5.2.1",
    "expo": "^54.0.7",
    "expo-font": "~14.0.8",
    "expo-linking": "~8.0.8",
    "expo-router": "~6.0.4",
    "expo-splash-screen": "~31.0.10",
    "expo-status-bar": "~3.0.8",
    "expo-system-ui": "~6.0.7",
    "expo-web-browser": "~15.0.7",
    "formik": "^2.4.9",
    "lucide-react-native": "^0.510.0",
    "nativewind": "^4.2.1",
    "react": "19.1.0",
    "react-aria": "^3.41.1",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-reanimated": "~4.1.0",
    "react-native-safe-area-context": "^5.6.1",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-web": "^0.21.0",
    "react-native-worklets": "0.5.1",
    "react-redux": "^9.2.0",
    "react-stately": "^3.39.0",
    "redux-persist": "^6.0.0",
    "tailwind-variants": "^0.1.20",
    "tailwindcss": "^3.4.17",
    "yup": "^1.7.1"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@testing-library/react-native": "^13.2.0",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.1.10",
    "jest": "^29.2.1",
    "jest-expo": "~54.0.11",
    "react-test-renderer": "19.1.0",
    "typescript": "~5.9.2"
  },
  "private": true
}
